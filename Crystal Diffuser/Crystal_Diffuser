def getcolor(item):
    match item:
        case (0,0,0):
            color = (255,255,255)
        case (1,0,0):
            color = (255,0,0)
        case (0,1,0):
            color = (255,255,0)
        case (0,0,1):
            color = (0,0,255)
        case (1,1,0):
            color = (255,128,0)
        case (0,1,1):
            color = (0,255,0)
        case (1,0,1):
            color = (255,0,255)
        case (1,1,1):
            color = (0,0,0)
    return color

