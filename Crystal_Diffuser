def drawlaser():
    global additionalloss
    nodes = Mnodes
    laserwidth = int(sizex/(ratiox/baselaserwidth))
    circlesize = int(sizex/(ratiox/basecirclesize))
    c_loss = (lossrate+additionalloss) * (microlaser-2)

    for x in range(microlaser):
        for i in range(len(nodes)-1):

            l_color = getcolor(nodes[i][-1])
            #separe (r,g,b) into r g b
            col1, col2, col3 = l_color
            #sets the colors with lost saturation and all

            color = (min(255,max(0,int(per(col1,c_loss,2)))), min(255,max(0,int(per(col2,c_loss,2)))), min(255,max(0,int(per(col3,c_loss,2)))))

            point1 = (int((nodes[i][0]*sizex)+(border*morph)+sizex/2),int((nodes[i][1]*sizey)+border)+sizey/2)
            point2 = (int((nodes[i+1][0]*sizex)+(border*morph)+sizex/2),int((nodes[i+1][1]*sizey)+border)+sizey/2)

            pygame.draw.line(screen, color, point1, point2, max(0,laserwidth))

            motion = (nodes[i+1][0]-nodes[i][0],nodes[i+1][1]-nodes[i][1])
            motion2 = (nodes[i][0]-nodes[i-1][0],nodes[i][1]-nodes[i-1][1])
            if motion != motion2 :
                pygame.draw.circle(screen, color,point1, int(laserwidth/2)+circlesize, 0)
        laserwidth -= widthloss
        c_loss -= lossrate

def simulatelaser(main):
    global ldirection, Mnodes, lorigin, cords
    laserorigin = lorigin
    if main == True:
        nodes = Mnodes.copy()
        laserdir = ldirection
    else:
        lcell = cords[main]
        if main in numberorder[:gridx]:
            laserdir = [0,1]
        if main in numberorder[gridx:gridx+gridy]:
            laserdir = [-1,0]
        if main in letterorder[:gridy]:
            laserdir = [1,0]
        if main in letterorder[gridy:gridx+gridy]:
            laserdir = [0,-1]
        gemtouched = (0,0,0)
        l_color = (0,0,0)
        nextcell = (lcell[0]+laserdir[0],lcell[1]+laserdir[1])
        if cords[nextcell] != "void":
            l_color = cords[nextcell][-1]
        laserorigin = ((lcell[0],lcell[1],gemtouched),laserdir)
        nodes = [(lcell[0],lcell[1],gemtouched),(lcell[0]+laserdir[0],lcell[1]+laserdir[1],l_color)]
                   
    while laserdir != "stop":
    #if True:
        nodekey = (nodes[-1][0],nodes[-1][1])
        l_color = nodes[-1][-1]  
        ccell = cords[nodekey]
        if ccell in letterorder or ccell in numberorder:
            if laserdir != "stop":
                if gridindex == 0:
                    if main == True:
                        if not ((cords[(laserorigin[0][0],laserorigin[0][1])], ccell, l_color) in notes or (ccell,cords[(laserorigin[0][0],laserorigin[0][1])] , l_color) in notes):
                            notes.append((cords[(laserorigin[0][0],laserorigin[0][1])], ccell, l_color))
            laserdir = "stop"
            
        if laserdir != "stop": 
            #handle laser and edge colision
            if ccell[0] == 1 or ccell[0] == 3:
                laserdir = [laserdir[1],laserdir[0]]
            elif ccell[0] == 2 or ccell[0] == 4:
                laserdir = [laserdir[1]*-1,laserdir[0]*-1]

            #preshots color change
            nextcell = cords[(nodekey[0]+laserdir[0],nodekey[1]+laserdir[1])] 

            if nextcell != "void":
                if not (nextcell in letterorder or nextcell in numberorder):
                    nextnode = nextcell[-1]
                    #adds two color tuples together
                    l_color = ( min(nodes[-1][-1][0]+nextnode[0],1) , min(nodes[-1][-1][1]+nextnode[1],1) , min(nodes[-1][-1][2]+nextnode[2],1) )

            nodes.append((nodekey[0]+laserdir[0],nodekey[1]+laserdir[1],l_color))
        if main == True:
            Mnodes = nodes.copy()
            ldirection = laserdir
            break
    if main != True:
        return (cords[nodes[-1][0],nodes[-1][1]],nodes[-1][2])

