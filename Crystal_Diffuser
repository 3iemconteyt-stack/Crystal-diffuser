def getcolor(item):
    #transform a color described in (red,yellow,blue) into (r,g,b)
    match item:
        case (0,0,0):
            color = (255,255,255)
        case (1,0,0):
            color = (255,0,0)
        case (0,1,0):
            color = (255,255,0)
        case (0,0,1):
            color = (0,0,255)
        case (1,1,0):
            color = (255,128,0)
        case (0,1,1):
            color = (0,255,0)
        case (1,0,1):
            color = (255,0,255)
        case (1,1,1):
            color = (0,0,0)
    return color

def drawsquare(x,y,mode):
        #draws the square based on a set of coordinates and includes anything overlaping with said square
        if mode == "grid" or mode == "both":
            rectangle = pygame.Rect((x*sizex+border*1.25),(y*sizey+border),(sizex),(sizey))
            if int(y)%2 == 1:
                if int(x)%2 == 1 :
                    squarecolor = color1
                else:
                    squarecolor = color2
            else:
                if int(x)%2 == 1 :
                    squarecolor = color2
                else:
                    squarecolor = color1
            pygame.draw.rect(screen,(squarecolor), rectangle)
        if mode == "shapes" or mode == "both":
            ccell = cords[(x,y)]
            if ccell != "void":
                drawtriangle(getcolor(ccell[1]),ccell[0],x,y)

def drawgrid(mode):
    #repeats drawsquare() for the whole grid
    for x in range(10):
        for y in range (8):
            drawsquare(x,y,mode)

def drawtriangle(color, rotation, x, y):
    #draws a polygon based on state 1-4 triangle and 9 square
    x = x*sizex+border*1.25
    y = y*sizey+border
    match rotation :
        case 1:
            pygame.draw.polygon(screen,color,( (x,y), (x+sizex-1,y) ,(x+sizex-1, y+sizey-1) ))
        case 2:
            pygame.draw.polygon(screen,color,( (x,y), (x+sizex-1,y) ,(x, y+sizey-1) ))
        case 3:
            pygame.draw.polygon(screen,color,( (x,y), (x+sizex-1,y+sizey-1) ,(x, y+sizey-1) ))
        case 4:
            pygame.draw.polygon(screen,color,( (x+sizex-1,y+sizey-1), (x+sizex-1,y) ,(x, y+sizey-1) ))
        case 9:
            rectangle=pygame.Rect((x),(y),(sizex),(sizey))
            pygame.draw.rect(screen,(color), rectangle)

def drawshape(shape,x,y,real):
    #draws a shape and adds in to the grid if real == True
    if checkshapecolision(shape,x,y):
        outshape = []
        shapecolor = shape[0]
        for piece in shape[1:]:
            drawtriangle((getcolor(shapecolor)),piece[0],piece[1]+x,piece[2]+y)
            if real:
                cords[(piece[1]+x),(piece[2]+y)] = (piece[0],shapecolor)
                outshape.append(((piece[1]+x),(piece[2]+y)))
        if real:
            placedshapes.append(outshape)
                
def rotateshape(shape,rotation):
    #rotates a shape by rotation*90 degrees
    rotation = (rotation) % 4
    
    if rotation > 0:
        positive = 1
    else:
        positive = -1 
    outshape = [shape[0]]
    for piece in shape[1:]:
        for i in range(rotation):
            piece = [piece[0], piece[2]*positive*-1, piece[1]*positive]
            if piece[0] != 9:
                piece[0] += positive*-1
                if piece[0] > 4:
                    piece[0] -= 4
                if piece[0] < 1:
                    piece[0] += 4
        outshape.append(piece)
    return outshape

def checkshapecolision(shape,x,y):
    #checks if a whole shape is inbound or clipping in another shape
    legal = True
    for piece in shape[1:]:
        if piece[1]+x < 10 and piece[1]+x >= 0 and piece[2]+y < 8 and piece[2]+y >= 0:
            legal = legal
        else:
            legal = False
        for i in range(len(placedshapes)):
            if (piece[1]+x,piece[2]+y) in placedshapes[i]:
                legal = False
    return legal

def convertmousecords():
    #returns if the mouse is inside the main grid and set mx and my to the mouse coordinate on the grid
    #mousepos to mouseposition (inside the grid, hovering letters or out of bound)
    #and mousecell to the cell the mouse is currently hovering
    global mx, my, mousepos, mousecell
    mousex, mousey = pygame.mouse.get_pos()
    mx = round(((mousex-border*1.25)/sizex)-0.5)
    my = round(((mousey-border)/sizey)-0.5) 
    if mx < -1 or mx > 10 or my < -1 or my > 8:
        mousepos = "out of bound"
    if mx < 11 and mx > -2 and my < 9 and my > -2:
        if not (mx == -1 and  my == -1) and not (mx == 10 and my == -1) and not (mx == -1 and my == 8) and not (mx == 10 and my == 8):
            if not (mx > -1 and my > -1 and mx < 10 and my < 8):
                mousepos = "extended grid"
            else:
                mousepos = "grid"
        else: 
            mousepos = "out of bound"

    if mousepos != "out of bound":
        mousecell = cords[(mx,my)]

    if mx < 0 or mx > 9 or my < 0 or my > 7:
        return False
    else:
        return True

def drawletters():
    for i in range(10):
        drawtext(letterorder[i],0+i,-1,True)
        drawtext(letterorder[i+26],0+i,8,True)
    for i in range(8):
        drawtext(letterorder[i+10],10,0+i,True)
        drawtext(letterorder[i+18],-1,0+i,True)

def drawtext(text,x,y,grid):
    
    if nodes != []:
        textcolor = getcolor(nodes[-1][-1])
    else:
        textcolor = (200,200,200)
    text_surface = my_font.render(text, False, textcolor)
    text_width, text_height = my_font.size(text)
    if not grid:
        screen.blit(text_surface, (x,y))
    if grid:
        screen.blit(text_surface,  (int((x*sizex)+(border*1.25)+(sizex/2-text_width/2)) , int((y*sizey)+border)+(sizey/2-text_height/2))) 
        cords[(x,y)] = text

def render():
    global preview
    screen.fill(fillcolor)
    drawgrid("grid")
    drawlaser()
    if convertmousecords():
        if preview:
            drawshape(rotateshape(currentshape,rotation),mx,my,False)
    drawgrid("shapes")
    convertmousecords()
    if mousepos == "extended grid":
        drawtriangle(highlight,9,mx,my)
    drawletters()
    mousex, mousey = pygame.mouse.get_pos()
    if erasing:
        preview = False
        drawpicture("asset/eraser.png",mousex,mousey,12*4,13*4)



    pygame.display.update()

def drawlaser():
    colorloss = int(lossrate+additionalloss) * (microlaser-2)
    for x in range(microlaser):
        for i in range(len(nodes)-1):
            lasercolor = getcolor(nodes[i][-1])
            col1, col2, col3 = lasercolor
            color = (min(255,max(0,col1-colorloss)), min(255,max(0,col2-colorloss)), min(255,max(0,col3-colorloss)))
            point1 = (int((nodes[i][0]*sizex)+(border*1.25)+sizex/2),int((nodes[i][1]*sizey)+border)+sizey/2)
            point2 = (int((nodes[i+1][0]*sizex)+(border*1.25)+sizex/2),int((nodes[i+1][1]*sizey)+border)+sizey/2)

            pygame.draw.line(screen, color, point1, point2, max(0,laserwidth))

            motion = (nodes[i+1][0]-nodes[i][0],nodes[i+1][1]-nodes[i][1])
            motion2 = (nodes[i][0]-nodes[i-1][0],nodes[i][1]-nodes[i-1][1])
            if motion != motion2 :
                pygame.draw.circle(screen, color,point1, int(laserwidth/2)+10, 0)
        laserwidth -= widthloss
        colorloss -= lossrate

def simulatelaser():
    global laserdir
    nodekey = (nodes[-1][0],nodes[-1][1])
    lasercolor = nodes[-1][-1]

    ccell = cords[nodekey]
    if ccell in letterorder:
        laserdir = "stop"
    if laserdir != "stop": 
        #handle laser and edge colision
        if ccell[0] == 1 or ccell[0] == 3:
            laserdir = [laserdir[1],laserdir[0]]
        elif ccell[0] == 2 or ccell[0] == 4:
            laserdir = [laserdir[1]*-1,laserdir[0]*-1]

        #preshots color change
        
        nextcell = cords[(nodekey[0]+laserdir[0],nodekey[1]+laserdir[1])]
        if nextcell != "void":
            if not (nextcell in letterorder):
                nextnode = nextcell[-1]

                #adds two color tuples together
                lasercolor = ( min(nodes[-1][-1][0]+nextnode[0],1) , min(nodes[-1][-1][1]+nextnode[1],1) , min(nodes[-1][-1][2]+nextnode[2],1) )

        nodes.append((nodekey[0]+laserdir[0],nodekey[1]+laserdir[1],lasercolor))

def drawpicture(picture,x,y,sizex,sizey):
    str(picture)
    picture = pygame.image.load(picture)
    pic = pygame.transform.scale(picture,(sizex,sizey))
    screen.blit(pic,(x-sizex/2,y-sizey/2))

def erase():
    if convertmousecords():
        convertmousecords()

        if mousecell != "void":
            for i in range(len(placedshapes)):
                if (mx,my) in placedshapes[i]:
                    for piece in placedshapes[i]:
                        cords[(piece)] = "void"
                    placedshapes.pop(i)
                    break

cords = {}
for x in range (10):
    for y in range (8):
        cords[(x,y)] = "void"

with open("shapes.json", "r") as f:
    shapes = json.load(f)["data"]
    currentshape = shapes[shapeindex]

render()
running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False 
        if event.type == pygame.KEYDOWN:
            key = event.key
            if key == pygame.K_SPACE:
                preview = not preview
                if preview:
                    erasing = False

            #rotates the current shape
            if key == pygame.K_RIGHT:
                rotation = (rotation+1) % 4
            if key == pygame.K_LEFT:
                rotation = (rotation-1) % 4

            #changes the current shape
            if key == pygame.K_UP:
                shapeindex = (shapeindex+1)%len(shapes)
            if key == pygame.K_DOWN:
                shapeindex = (shapeindex-1)%len(shapes)
            currentshape = shapes[shapeindex]
            if key == pygame.K_a:
                erasing = not erasing
        if event.type == pygame.MOUSEBUTTONUP:
            if event.button == 1:
                clicking = False
                if preview:
                    if convertmousecords():
                        drawshape(rotateshape(currentshape,rotation),mx,my,True)
                convertmousecords()
                if mousepos == "extended grid":
                    if mousecell in letterorder[:10]:
                        laserdir = [0,1]
                    if mousecell in letterorder[10:18]:
                        laserdir = [-1,0]
                    if mousecell in letterorder[18:26]:
                        laserdir = [1,0]
                    if mousecell in letterorder[26:36]:
                        laserdir = [0,-1]
                        gemtouched = (0,0,0)
                    nodes = [(mx,my,gemtouched), (mx+laserdir[0],my+laserdir[1],gemtouched)]

            #changes the current shape
            if event.button == 3:
                shapeindex  = (shapeindex-1)%len(shapes)
            if event.button == 2:
                shapeindex  = (shapeindex+1)%len(shapes)
            currentshape = shapes[shapeindex]

            #rotates the current shape
            if event.button == 4:
                rotation = (rotation+1) % 4
            if event.button == 5:
                rotation = (rotation-1) % 4
        if event.type == pygame.MOUSEBUTTONDOWN:
            clicking = True
    if erasing and clicking:
        erase()
    ticks += 1
    if nodes != []:
        if ticks % 25 == 1:
            simulatelaser()
    render()
    additionalloss += losscyclerate*loss
    if additionalloss > maxadditionalloss:
        loss = loss *-1
    if additionalloss < 0:
        loss = loss *-1
pygame.quit()