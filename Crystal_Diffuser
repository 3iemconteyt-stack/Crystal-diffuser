    screen.fill(fillcolor)
    drawgrid("grid")
    drawlaser()
    if checkcursor():
        if preview:
            drawshape(rotateshape(currentshape,rotation),mx,my,False)
    drawgrid("shapes")
    checkcursor()
    if mousepos == "extended grid":
        drawtriangle(highlight,9,mx,my)
    drawletters()
    mousex, mousey = pygame.mouse.get_pos()
    if erasing:
        preview = False
        drawpicture("asset/eraser.png",mousex,mousey,12*4,13*4)



    pygame.display.update()

def drawlaser():
    laserwidth = int(sizex/(ratiox/baselaserwidth))
    circlesize = int(sizex/(ratiox/basecirclesize))
    colorloss = int(lossrate+additionalloss) * (microlaser-2)
    for x in range(microlaser):
        for i in range(len(nodes)-1):
            lasercolor = getcolor(nodes[i][-1])
            col1, col2, col3 = lasercolor
            color = (min(255,max(0,col1-colorloss)), min(255,max(0,col2-colorloss)), min(255,max(0,col3-colorloss)))
            point1 = (int((nodes[i][0]*sizex)+(border*morph)+sizex/2),int((nodes[i][1]*sizey)+border)+sizey/2)
            point2 = (int((nodes[i+1][0]*sizex)+(border*morph)+sizex/2),int((nodes[i+1][1]*sizey)+border)+sizey/2)

            pygame.draw.line(screen, color, point1, point2, max(0,laserwidth))

            motion = (nodes[i+1][0]-nodes[i][0],nodes[i+1][1]-nodes[i][1])
            motion2 = (nodes[i][0]-nodes[i-1][0],nodes[i][1]-nodes[i-1][1])
            if motion != motion2 :
                pygame.draw.circle(screen, color,point1, int(laserwidth/2)+circlesize, 0)
        laserwidth -= widthloss
        colorloss -= lossrate

def simulatelaser():
    global laserdir
    nodekey = (nodes[-1][0],nodes[-1][1])
    lasercolor = nodes[-1][-1]  

    ccell = cords[nodekey]
    if ccell in letterorder or ccell in numberorder:
        laserdir = "stop"
    if laserdir != "stop": 
        #handle laser and edge colision
        if ccell[0] == 1 or ccell[0] == 3:
            laserdir = [laserdir[1],laserdir[0]]
        elif ccell[0] == 2 or ccell[0] == 4:
            laserdir = [laserdir[1]*-1,laserdir[0]*-1]

        #preshots color change
        nextcell = cords[(nodekey[0]+laserdir[0],nodekey[1]+laserdir[1])] 

        if nextcell != "void":
            if not (nextcell in letterorder or nextcell in numberorder):
                nextnode = nextcell[-1]
                #adds two color tuples together
                lasercolor = ( min(nodes[-1][-1][0]+nextnode[0],1) , min(nodes[-1][-1][1]+nextnode[1],1) , min(nodes[-1][-1][2]+nextnode[2],1) )

        nodes.append((nodekey[0]+laserdir[0],nodekey[1]+laserdir[1],lasercolor))

def drawpicture(picture,x,y,sizex,sizey):
    str(picture)
    picture = pygame.image.load(picture)
    pic = pygame.transform.scale(picture,(sizex,sizey))
    screen.blit(pic,(x-sizex/2,y-sizey/2))

def erase():
    global shouldredraw
    if checkcursor():
        checkcursor()

        if mousecell != "void":
            shouldredraw = True
            for i in range(len(placedshapes)):
                if (mx,my) in placedshapes[i]:
                    for piece in placedshapes[i]:
                        cords[(piece)] = "void"
                    placedshapes.pop(i) 
                    break

def switchgrid(switch):
    global cords, placedshapes, gridindex, gridlist, nodes
    cords["group"] = placedshapes
    cords["nodes"] = nodes
    gridlist[gridindex] = cords
    gridindex = (gridindex+switch) % len(gridlist)
    cords = gridlist[gridindex]
    if len(cords) == 0:
        cords = {}
        for x in range (gridx):
            for y in range (gridx):
                cords[(x,y)] = "void"
        cords["group"] = []
        cords["nodes"] = []
    placedshapes = cords["group"]
    nodes = cords["nodes"]


for i in range(gridamount):
    gridlist.append({})

cords = {}
for x in range(gridx):
    for y in range(gridy):
        cords[(x,y)] = "void"

cords["group"] = []
cords["nodes"] = []

with open("shapes.json", "r") as f:
    shapes = json.load(f)["basic"]
    currentshape = shapes[shapeindex]


running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False 
        if event.type == pygame.KEYDOWN:
            key = event.key
            if key == pygame.K_SPACE:
                preview = not preview
                if preview:
                    erasing = False

            #rotates the current shape
            if key == pygame.K_RIGHT:
                rotation = (rotation+1) % 4
            if key == pygame.K_LEFT:
                rotation = (rotation-1) % 4
            if key == pygame.K_t:
                rotation = (rotation-1) % 4
            if key == pygame.K_r:
                rotation = (rotation+1) % 4

            #changes the current shape
            if key == pygame.K_UP:
                shapeindex = (shapeindex+1)%len(shapes)
            if key == pygame.K_DOWN:
                shapeindex = (shapeindex-1)%len(shapes)
            if key == pygame.K_a:
                shapeindex = (shapeindex-1)%len(shapes)
            if key == pygame.K_e:
                shapeindex = (shapeindex+1)%len(shapes)
            currentshape = shapes[shapeindex]

            if key == pygame.K_c:
                shownotes = not shownotes
            if key == pygame.K_f:
                switchgrid(-1)
            if key == pygame.K_g:
                switchgrid(1)
            if key == pygame.K_TAB:
                erasing = not erasing

        if event.type == pygame.MOUSEBUTTONUP:
            clicking = False
            if event.button == 1:
                if preview:
                    if checkcursor():
                        drawshape(rotateshape(currentshape,rotation),mx,my,True)
                checkcursor()
                if mousepos == "extended grid":
                    if mousecell in numberorder[:gridx]:
                        laserdir = [0,1]
                    if mousecell in numberorder[gridx:gridx+gridy]:
                        laserdir = [-1,0]
                    if mousecell in letterorder[:gridy]:
                        laserdir = [1,0]
                    if mousecell in letterorder[gridy:gridx+gridy]:
                        laserdir = [0,-1]
                    gemtouched = (0,0,0)
                    lcolor = (0,0,0)
                    nextcell = (mx+laserdir[0],my+laserdir[1])
                    if cords[nextcell] != "void":
                        lcolor = cords[nextcell][-1]
                    laserorigin = ((mx,my,gemtouched),laserdir)
                    nodes = [(mx,my,gemtouched),(mx+laserdir[0],my+laserdir[1],lcolor)]

            #changes the current shape
            if event.button == 3:
                shapeindex  = (shapeindex-1)%len(shapes)
            if event.button == 2:
                shapeindex  = (shapeindex+1)%len(shapes)
            currentshape = shapes[shapeindex]

            #rotates the current shape
            if event.button == 4:
                rotation = (rotation+1) % 4
            if event.button == 5:
                rotation = (rotation-1) % 4
        if event.type == pygame.MOUSEBUTTONDOWN:
            clicking = True

    if erasing and clicking:
        erase()
    if erasing:
        pygame.mouse.set_visible(False)
    else:
        pygame.mouse.set_visible(True)
    ticks += 1
    if nodes != []:
        if ticks % laserspeed == 1:
            simulatelaser()

    if shouldredraw :
        if len(nodes) != 0:
            pastnodes = nodes
            shouldredraw = False
            lx = laserorigin[0][0]
            ly = laserorigin[0][1]
            laserdir = laserorigin[1]
            nextcell = (lx+laserdir[0],ly+laserdir[1])
            lcolor = (0,0,0)
            if cords[nextcell] != "void":
                lcolor = cords[nextcell][-1]
            nodes = [(lx,ly,(0,0,0)),(lx+laserdir[0],ly+laserdir[1],lcolor)]
            while pastnodes[:len(nodes)] == nodes:
                simulatelaser()
                if laserdir == "stop":
                    break
            simulatelaser()

            
    print(screen_width)
    screen_width = basescreenwidth+(int(shownotes)*100)


    additionalloss += losscyclerate*loss
    if additionalloss > maxadditionalloss:
        loss = loss *-1
    if additionalloss < 0:
        loss = loss *-1
    render()

