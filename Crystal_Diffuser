def sin(angle):
    return math.sin(math.radians(angle))

def cos(angle):
    return math.cos(math.radians(angle))

def per(a,b,mode):
    if mode == 1:
        return a*b/100
    if mode == 2:
        return a*(100-b)/100
    
def distance(point1, point2):
    x1, y1 = point1
    x2, y2 = point2
    return ((x1-x2)^2+(y1-y2)^2)^0.5

def get_textsize(text, size):
